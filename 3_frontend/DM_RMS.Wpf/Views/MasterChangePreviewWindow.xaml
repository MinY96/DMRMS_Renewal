<Window x:Class="DM_RMS.Wpf.Views.MasterChangePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Recipe 변경 미리보기" Width="870" Height="560"
        MinWidth="640" MinHeight="430" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="저장 전 변경사항 확인" Style="{StaticResource PageTitleTextStyle}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
            <TextBlock Text="Master Key: " FontWeight="SemiBold" />
            <TextBlock Text="{Binding MasterKey}" Margin="0,0,16,0" />
            <TextBlock Text="변경 Parameter: " FontWeight="SemiBold" />
            <TextBlock Text="{Binding ChangedCount, StringFormat={}{0:N0}건}" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Changes}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="2*" />
                <DataGridTextColumn Header="기존값" Binding="{Binding OriginalValue}" Width="2*" />
                <DataGridTextColumn Header="변경값" Binding="{Binding UpdatedValue}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Command="{Binding CancelCommand}" Width="88" />
            <Button Content="변경사항 저장" Command="{Binding ConfirmCommand}" Width="136"
                    Style="{StaticResource SoftPrimaryButtonStyle}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
