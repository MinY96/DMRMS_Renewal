<Window x:Class="DM_RMS.Wpf.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bh="clr-namespace:DM_RMS.Wpf.Behaviors"
        Title="DM RMS 신규 등록"
        Height="500"
        Width="430"
        WindowStartupLocation="CenterOwner" Icon="/DM_RMS;component/Resources/DM_RMS.ico"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}"
                Width="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="24">
            <StackPanel>
                <TextBlock Text="신규 등록"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,4" />
                <TextBlock Text="사용자 계정을 등록합니다."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,0,0,20" />

                <TextBlock Text="사업장" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding FabOptions}"
                          SelectedItem="{Binding SelectedFab}"
                          Height="32"
                          Margin="0,0,0,12" />

                <TextBlock Text="아이디" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,0,0,12" />

                <TextBlock Text="패스워드" FontWeight="SemiBold" Margin="0,0,0,5" />
                <PasswordBox bh:PasswordBoxBindingBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             Margin="0,0,0,12" />

                <TextBlock Text="표시 이름" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Margin="0,0,0,18" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="등록"
                            Command="{Binding RegisterCommand}"
                            Height="38"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Grid.Column="2"
                            Content="닫기"
                            Command="{Binding CloseCommand}"
                            Height="38" />
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
