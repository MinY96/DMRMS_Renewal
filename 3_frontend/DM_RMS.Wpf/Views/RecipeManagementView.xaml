<UserControl x:Class="DM_RMS.Wpf.Views.RecipeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bh="clr-namespace:DM_RMS.Wpf.Behaviors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Recipe 관리" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="좌측 장비 현황 선택 → Recipe 조회 → 상세 확인 → 우측 처리 목록에서 백업/삭제"
                               Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedFab}" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="장비 현황 새로고침"
                            Style="{StaticResource SoftPrimaryButtonStyle}"
                            Command="{Binding LoadEquipmentSummaryCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- 항상 표시되는 핵심 작업 영역 -->
            <Grid x:Name="MainWorkspace" Margin="38,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Effect" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnySidePanelOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="2" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.25*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recipe 리스트" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="체크 시 우측 처리 목록에 반영되며, 행 더블클릭 시 하단에서 상세 Parameter를 조회합니다."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding RecipeListRowCount, StringFormat={}{0:N0} 행}" />
                                </Border>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding CopyRecipeListCommand}"
                                        ToolTip="클립보드 복사">
                                    <Viewbox Width="15" Height="15">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M6,2 H14 A2,2 0 0 1 16,4 V14 A2,2 0 0 1 14,16 H6 A2,2 0 0 1 4,14 V4 A2,2 0 0 1 6,2 M3,6 H2 A2,2 0 0 0 0,8 V18 A2,2 0 0 0 2,20 H10 A2,2 0 0 0 12,18 V17 H4 A1,1 0 0 1 3,16 Z" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding ExportRecipeListExcelCommand}"
                                        ToolTip="Excel 저장">
                                    <Viewbox Width="16" Height="16">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M3,2 H13 A2,2 0 0 1 15,4 V7 H13 V4 H3 V16 H8 V18 H3 A2,2 0 0 1 1,16 V4 A2,2 0 0 1 3,2 M10,8 H12 V11 H15 V13 H12 V16 H10 V13 H7 V11 H10 Z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding RecipeListView}"
                                  AutoGenerateColumns="True"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                  ColumnHeaderHeight="64"
                                  bh:DataGridHiddenColumnsBehavior.HiddenColumns="internal_id,recipe_key,no_master"
                                  bh:DataGridTextColumnFormatBehavior.CenterHeaders="True"
                                  bh:DataGridColumnFilterHeaderBehavior.FiltersSource="{Binding RecipeFilters}"
                                  bh:RecipeRowHighlightBehavior.IsEnabled="True"
                                  bh:DataGridImmediateCheckBoxBehavior.SelectionColumnName="is_selected"
                                  bh:DataGridImmediateCheckBoxBehavior.EnableSelectAllHeader="True"
                                  bh:DataGridImmediateCheckBoxBehavior.SelectAllCommand="{Binding SetVisibleRecipeSelectionCommand}"
                                  bh:DataGridImmediateCheckBoxBehavior.SelectAllState="{Binding AreAllVisibleRecipesSelected, Mode=OneWay}"
                                  bh:DataGridRowDoubleClickBehavior.Command="{Binding LoadRecipeDetailCommand}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recipe 상세 Parameter" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="Recipe 리스트의 행을 더블클릭하면 Parameter별 설정값과 Master Matching 결과를 확인할 수 있습니다."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding RecipeDetailRowCount, StringFormat={}{0:N0} 행}" />
                                </Border>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CopyRecipeDetailCommand}" ToolTip="클립보드 복사">
                                    <Viewbox Width="15" Height="15">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M6,2 H14 A2,2 0 0 1 16,4 V14 A2,2 0 0 1 14,16 H6 A2,2 0 0 1 4,14 V4 A2,2 0 0 1 6,2 M3,6 H2 A2,2 0 0 0 0,8 V18 A2,2 0 0 0 2,20 H10 A2,2 0 0 0 12,18 V17 H4 A1,1 0 0 1 3,16 Z" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ExportRecipeDetailExcelCommand}" ToolTip="Excel 저장">
                                    <Viewbox Width="16" Height="16">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M3,2 H13 A2,2 0 0 1 15,4 V7 H13 V4 H3 V16 H8 V18 H3 A2,2 0 0 1 1,16 V4 A2,2 0 0 1 3,2 M10,8 H12 V11 H15 V13 H12 V16 H10 V13 H7 V11 H10 Z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding RecipeDetailView}"
                                  AutoGenerateColumns="True"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  bh:DataGridTextColumnFormatBehavior.CenterHeaders="True"
                                  bh:DataGridConditionalHighlightBehavior.ColumnName="matching"
                                  bh:DataGridConditionalHighlightBehavior.MatchValue="False"
                                  bh:DataGridConditionalHighlightBehavior.HighlightTarget="Row" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 화면 가장자리의 고정 패널 버튼 -->
            <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="34" Height="150" Padding="4"
                    Command="{Binding ToggleEquipmentPanelCommand}"
                    Style="{StaticResource SoftPrimaryButtonStyle}"
                    Panel.ZIndex="20" ToolTip="장비 별 Recipe 현황 열기">
                <TextBlock Text="장비 현황" FontWeight="SemiBold">
                    <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </Button>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="34" Height="150" Padding="4"
                    Command="{Binding ToggleProcessingPanelCommand}"
                    Style="{StaticResource SoftPrimaryButtonStyle}"
                    Panel.ZIndex="20" ToolTip="처리 Recipe 보관 리스트 열기">
                <TextBlock Text="처리 목록" FontWeight="SemiBold">
                    <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                </TextBlock>
            </Button>

            <!-- 패널이 열릴 때 메인 영역을 흐리게 보이도록 하는 반투명 오버레이 -->
            <Button Background="#52000000" BorderThickness="0" Padding="0"
                    Command="{Binding CloseSidePanelsCommand}"
                    Visibility="{Binding IsAnySidePanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="30" ToolTip="사이드 패널 닫기">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 좌측 장비 현황 슬라이드 패널 -->
            <Border Width="{Binding EquipmentPanelWidth}" HorizontalAlignment="Left" Margin="0,4,0,4"
                    Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,1,1"
                    IsHitTestVisible="{Binding IsEquipmentPanelOpen}" Panel.ZIndex="40">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" /></Border.Effect>
                <Border.RenderTransform><TranslateTransform X="-980" /></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEquipmentPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="-980" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="장비 별 Recipe 현황" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="조회할 장비를 체크한 뒤 하단의 Recipe 조회를 실행하세요." Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding EquipmentSummaryRowCount, StringFormat={}{0:N0} 행}" />
                            </Border>
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding CopyEquipmentSummaryCommand}" ToolTip="클립보드 복사">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M6,2 H14 A2,2 0 0 1 16,4 V14 A2,2 0 0 1 14,16 H6 A2,2 0 0 1 4,14 V4 A2,2 0 0 1 6,2 M3,6 H2 A2,2 0 0 0 0,8 V18 A2,2 0 0 0 2,20 H10 A2,2 0 0 0 12,18 V17 H4 A1,1 0 0 1 3,16 Z" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ExportEquipmentSummaryExcelCommand}" ToolTip="Excel 저장">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M3,2 H13 A2,2 0 0 1 15,4 V7 H13 V4 H3 V16 H8 V18 H3 A2,2 0 0 1 1,16 V4 A2,2 0 0 1 3,2 M10,8 H12 V11 H15 V13 H12 V16 H10 V13 H7 V11 H10 Z" />
                                </Viewbox>
                            </Button>
                            <TextBlock Text="폭" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <Slider Width="92" Minimum="440" Maximum="850" TickFrequency="10"
                                    Value="{Binding EquipmentPanelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="장비 현황 패널 폭 조절" VerticalAlignment="Center" />
                            <Button Content="닫기" Command="{Binding CloseEquipmentPanelCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,10,0,0"
                              ItemsSource="{Binding EquipmentSummaryView}"
                              AutoGenerateColumns="True"
                              CanUserAddRows="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              bh:DataGridHiddenColumnsBehavior.HiddenColumns="internal_id,recipe_key,no_master"
                              bh:DataGridTextColumnFormatBehavior.CenterHeaders="True"
                              bh:DataGridImmediateCheckBoxBehavior.SelectionColumnName="is_selected" />
                    <Button Grid.Row="2" Content="선택 장비 Recipe 조회"
                            Style="{StaticResource SoftPrimaryButtonStyle}"
                            Command="{Binding SearchRecipesCommand}" MinHeight="38" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 우측 처리 Recipe 슬라이드 패널 -->
            <Border Width="{Binding ProcessingPanelWidth}" HorizontalAlignment="Right" Margin="0,4,0,4"
                    Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,1,0,1"
                    IsHitTestVisible="{Binding IsProcessingPanelOpen}" Panel.ZIndex="40">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="-4" Opacity="0.28" /></Border.Effect>
                <Border.RenderTransform><TranslateTransform X="980" /></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProcessingPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="980" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="처리 Recipe 보관 리스트" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="패널을 닫아도 선택 목록과 입력 상태는 유지됩니다." Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0" 
                                    ToolTip="한 번에 처리할 수 있는 최대 Recipe 수">
                                <TextBlock Text="{Binding SelectedRecipeCountText}" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="전체 비우기" Style="{StaticResource SoftDangerSmallButtonStyle}"
                                    Command="{Binding ClearSelectedRecipesCommand}" />
                            <TextBlock Text="폭" VerticalAlignment="Center" Margin="4,0,2,0" />
                            <Slider Width="92" Minimum="470" Maximum="900" TickFrequency="10"
                                    Value="{Binding ProcessingPanelWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="처리 Recipe 패널 폭 조절" VerticalAlignment="Center" />
                            <Button Content="닫기" Command="{Binding CloseProcessingPanelCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" Margin="0,10,0,0"
                              ItemsSource="{Binding SelectedRecipes}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="장비" Binding="{Binding EqpId}" Width="1.05*" />
                            <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName}" Width="1.55*" />
                            <DataGridTextColumn Header="결과" Binding="{Binding OperationStatus}" Width="65" />
                            <DataGridTextColumn Header="상세" Binding="{Binding OperationMessage}" Width="1.25*" />
                            <DataGridTemplateColumn Header="제거" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="제거" Style="{StaticResource DangerSmallButtonStyle}"
                                                Command="{Binding DataContext.RemoveSelectedRecipeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource ProcessingActionPanelStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding LastOperationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,5" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="성공 " /><TextBlock Text="{Binding LastSuccessCount}" Foreground="#166534" FontWeight="Bold" />
                                <TextBlock Text="    실패 " /><TextBlock Text="{Binding LastFailureCount}" Foreground="#B91C1C" FontWeight="Bold" />
                                <TextBlock Text="    미처리·확인 필요 " /><TextBlock Text="{Binding LastUnprocessedCount}" Foreground="#92400E" FontWeight="Bold" />
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="백업 경로 지정" Command="{Binding ChooseBackupPathCommand}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BackupPath, TargetNullValue=백업 경로가 지정되지 않았습니다.}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding BackupPath}" Margin="8,0,0,0"
                                           Style="{StaticResource MutedTextStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Recipe 백업"
                                        Style="{StaticResource SoftPrimaryButtonStyle}"
                                        Command="{Binding BackupSelectedRecipesCommand}" Margin="0,0,4,0" />
                                <Button Grid.Column="1" Content="Recipe 삭제"
                                        IsEnabled="{Binding CanDeleteRecipes}"
                                        ToolTip="관리자 계정에서만 사용할 수 있습니다."
                                        Style="{StaticResource SoftDangerButtonStyle}"
                                        Command="{Binding DeleteSelectedRecipesCommand}" Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
