<Window x:Class="DM_RMS.Wpf.Views.NewMasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DM_RMS.Wpf.Converters"
        xmlns:bh="clr-namespace:DM_RMS.Wpf.Behaviors"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="신규 Master Recipe 생성" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner" Icon="/DM_RMS;component/Resources/DM_RMS.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="IntegerUpDownStyle" TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="Height" Value="26" />
            <Setter Property="IsEnabled" Value="{Binding IsEditMode}" />
            <Setter Property="ToolTip" Value="{Binding ValidationError}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoubleUpDownStyle" TargetType="{x:Type xctk:DoubleUpDown}">
            <Setter Property="Height" Value="26" />
            <Setter Property="IsEnabled" Value="{Binding IsEditMode}" />
            <Setter Property="ToolTip" Value="{Binding ValidationError}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StringEditTemplate">
            <ComboBox ItemsSource="{Binding AllowedValues}"
                      SelectedItem="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      IsEnabled="{Binding IsEditMode}"
                      MinWidth="140" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerNumberEditTemplate">
            <xctk:IntegerUpDown Value="{Binding EditIntegerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Increment="1"
                                Width="140"
                                Style="{StaticResource IntegerUpDownStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="DoubleNumberEditTemplate">
            <xctk:DoubleUpDown Value="{Binding EditDoubleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Increment="0.1"
                               FormatString="F3"
                               Width="140"
                               Style="{StaticResource DoubleUpDownStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerRangeEditTemplate">
            <StackPanel Orientation="Horizontal">
                <xctk:IntegerUpDown Value="{Binding EditIntegerMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Increment="1"
                                    Width="92"
                                    Style="{StaticResource IntegerUpDownStyle}" />
                <TextBlock Text=" ~ " VerticalAlignment="Center" />
                <xctk:IntegerUpDown Value="{Binding EditIntegerMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Increment="1"
                                    Width="92"
                                    Style="{StaticResource IntegerUpDownStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DoubleRangeEditTemplate">
            <StackPanel Orientation="Horizontal">
                <xctk:DoubleUpDown Value="{Binding EditDoubleMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Increment="0.1"
                                   FormatString="F3"
                                   Width="92"
                                   Style="{StaticResource DoubleUpDownStyle}" />
                <TextBlock Text=" ~ " VerticalAlignment="Center" />
                <xctk:DoubleUpDown Value="{Binding EditDoubleMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Increment="0.1"
                                   FormatString="F3"
                                   Width="92"
                                   Style="{StaticResource DoubleUpDownStyle}" />
            </StackPanel>
        </DataTemplate>

        <conv:MasterEditTemplateSelector x:Key="MasterEditTemplateSelector"
                                         StringTemplate="{StaticResource StringEditTemplate}"
                                         IntegerNumberTemplate="{StaticResource IntegerNumberEditTemplate}"
                                         DoubleNumberTemplate="{StaticResource DoubleNumberEditTemplate}"
                                         IntegerRangeTemplate="{StaticResource IntegerRangeEditTemplate}"
                                         DoubleRangeTemplate="{StaticResource DoubleRangeEditTemplate}" />
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="선택 Model: " FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedModel}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Margin="20,0,0,0" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding CriteriaValidationMessage}" Foreground="#A43A3A"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="생성" Width="90" Height="32" Command="{Binding CreateMasterCommand}"
                    IsEnabled="{Binding CanCreateMaster}" />
            <Button Content="닫기" Width="90" Height="32" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="좌측 기준 정보" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Criteria}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding DisplayName}" />
                                        <TextBlock Text=" *" Foreground="#B91C1C" FontWeight="Bold"
                                                   Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedValue}"
                                              Text="{Binding SelectedValue, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLikeFilter}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLikeFilter}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="필수 입력" Foreground="#B91C1C" FontSize="11"
                                               Visibility="{Binding IsMissingRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Header="우측 Parameter 설정" Grid.Column="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <ComboBox Width="220"
                                  ItemsSource="{Binding ParameterOptions}"
                                  SelectedItem="{Binding SelectedParameterOption}"
                                  DisplayMemberPath="ParameterName" />
                        <Button Content="추가" Width="70" Margin="8,0,0,0" Command="{Binding AddParameterCommand}" />
                        <Button Content="불러오기" Width="90" Margin="8,0,0,0" Command="{Binding LoadJsonFileCommand}" />
                        <TextBlock Text="  ※ 초기 테이블은 샘플 Parameter 데이터" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Parameters}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              bh:DataGridHiddenColumnsBehavior.HiddenColumns="ControlType"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="2*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Master 설정값" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource MasterEditTemplateSelector}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Control Type" Binding="{Binding ControlType}" Width="1.2*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="삭제" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제"
                                                Padding="6,2"
                                                Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
