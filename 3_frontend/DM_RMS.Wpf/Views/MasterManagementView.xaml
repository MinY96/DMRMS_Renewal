<UserControl x:Class="DM_RMS.Wpf.Views.MasterManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:bh="clr-namespace:DM_RMS.Wpf.Behaviors"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:conv="clr-namespace:DM_RMS.Wpf.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="IntegerUpDownStyle" TargetType="{x:Type xctk:IntegerUpDown}">
            <Setter Property="Height" Value="26" />
            <Setter Property="IsEnabled" Value="{Binding IsEditMode}" />
            <Setter Property="ToolTip" Value="{Binding ValidationError}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DoubleUpDownStyle" TargetType="{x:Type xctk:DoubleUpDown}">
            <Setter Property="Height" Value="26" />
            <Setter Property="IsEnabled" Value="{Binding IsEditMode}" />
            <Setter Property="ToolTip" Value="{Binding ValidationError}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StringEditTemplate">
            <ComboBox ItemsSource="{Binding AllowedValues}"
                      SelectedItem="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditMode}"
                      MinWidth="140" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerNumberEditTemplate">
            <xctk:IntegerUpDown Value="{Binding EditIntegerValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Increment="1"
                                Width="140"
                                Style="{StaticResource IntegerUpDownStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="DoubleNumberEditTemplate">
            <xctk:DoubleUpDown Value="{Binding EditDoubleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Increment="0.1"
                               FormatString="F3"
                               Width="140"
                               Style="{StaticResource DoubleUpDownStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerRangeEditTemplate">
            <StackPanel Orientation="Horizontal">
                <xctk:IntegerUpDown Value="{Binding EditIntegerMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Increment="1"
                                    Width="92"
                                    Style="{StaticResource IntegerUpDownStyle}" />
                <TextBlock Text=" ~ " VerticalAlignment="Center" />
                <xctk:IntegerUpDown Value="{Binding EditIntegerMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Increment="1"
                                    Width="92"
                                    Style="{StaticResource IntegerUpDownStyle}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DoubleRangeEditTemplate">
            <StackPanel Orientation="Horizontal">
                <xctk:DoubleUpDown Value="{Binding EditDoubleMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Increment="0.1"
                                   FormatString="F3"
                                   Width="92"
                                   Style="{StaticResource DoubleUpDownStyle}" />
                <TextBlock Text=" ~ " VerticalAlignment="Center" />
                <xctk:DoubleUpDown Value="{Binding EditDoubleMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Increment="0.1"
                                   FormatString="F3"
                                   Width="92"
                                   Style="{StaticResource DoubleUpDownStyle}" />
            </StackPanel>
        </DataTemplate>

        <conv:MasterEditTemplateSelector x:Key="MasterEditTemplateSelector"
                                         StringTemplate="{StaticResource StringEditTemplate}"
                                         IntegerNumberTemplate="{StaticResource IntegerNumberEditTemplate}"
                                         DoubleNumberTemplate="{StaticResource DoubleNumberEditTemplate}"
                                         IntegerRangeTemplate="{StaticResource IntegerRangeEditTemplate}"
                                         DoubleRangeTemplate="{StaticResource DoubleRangeEditTemplate}" />
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Master Recipe 관리" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="기준정보 조회 → Master 상세 확인 → 변경 Parameter만 저장 / 신규 Master 생성" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding SelectedModelDescription}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource BadgeStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedFab}" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <ComboBox Width="155" Margin="0,0,8,0"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Model을 선택하면 기준정보 필터가 자동으로 초기화됩니다." />
                    <Button Content="필터 새로고침" Command="{Binding LoadFilterOptionsCommand}" />
                    <Button Content="신규 Master 생성" IsEnabled="{Binding CanCreateNewMaster}" ToolTip="Model 선택 및 관리자 권한이 필요합니다." Style="{StaticResource SoftPrimaryButtonStyle}" Command="{Binding OpenNewMasterCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Master Recipe 기준 정보 필터" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="Fab별 기준정보에 맞춰 필터가 자동 구성됩니다." Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar Width="64" Height="5" Margin="0,0,8,0" IsIndeterminate="True"
                                     Visibility="{Binding IsLoadingFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding FilterLoadingDescription}" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
                        <Button Content="조회" Style="{StaticResource SoftPrimaryButtonStyle}"
                                Command="{Binding SearchMasterListCommand}" IsEnabled="{Binding CanSearchMasterList}" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Filters}" Margin="24,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,14,8" MinWidth="145">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                <Grid>
                                    <ComboBox MinWidth="135" HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedValue}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLikeFilter}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <TextBox MinWidth="135" HorizontalAlignment="Stretch" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLikeFilter}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.85*" />
            </Grid.ColumnDefinitions>

            <!-- Master list table -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="8,8,4,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Master 기준 정보" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="조회 버튼으로 우측 상세를 열고, 삭제 버튼으로 Master Key를 제거합니다."
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MasterListRowCount, StringFormat={}{0:N0} 행}" />
                            </Border>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CopyMasterListCommand}"
                                    ToolTip="클립보드 복사">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M6,2 H14 A2,2 0 0 1 16,4 V14 A2,2 0 0 1 14,16 H6 A2,2 0 0 1 4,14 V4 A2,2 0 0 1 6,2 M3,6 H2 A2,2 0 0 0 0,8 V18 A2,2 0 0 0 2,20 H10 A2,2 0 0 0 12,18 V17 H4 A1,1 0 0 1 3,16 Z" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ExportMasterListExcelCommand}"
                                    ToolTip="Excel 저장">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M3,2 H13 A2,2 0 0 1 15,4 V7 H13 V4 H3 V16 H8 V18 H3 A2,2 0 0 1 1,16 V4 A2,2 0 0 1 3,2 M10,8 H12 V11 H15 V13 H12 V16 H10 V13 H7 V11 H10 Z" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid ItemsSource="{Binding MasterListView}"
                              AutoGenerateColumns="True"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              ColumnHeaderHeight="64"
                              bh:DataGridColumnFilterHeaderBehavior.FiltersSource="{Binding MasterListColumnFilters}"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              bh:DataGridTextColumnFormatBehavior.CenterHeaders="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="조회" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="조회"
                                                Style="{StaticResource SoftPrimarySmallButtonStyle}"
                                                Command="{Binding DataContext.LoadMasterDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="삭제" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제"
                                                IsEnabled="{Binding DataContext.CanManageMaster, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="관리자 계정에서만 사용할 수 있습니다."
                                                Style="{StaticResource SoftDangerSmallButtonStyle}"
                                                Command="{Binding DataContext.DeleteMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Master detail table -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,8,8,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Master 상세 Parameter" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Parameter별 Master 설정값을 확인하고, 편집 모드에서 변경된 행만 저장합니다."
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                <TextBlock Text="{Binding MasterDetailRowCount, StringFormat={}{0:N0} 행}" />
                            </Border>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CopyMasterDetailCommand}"
                                    ToolTip="클립보드 복사">
                                <Viewbox Width="15" Height="15">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M6,2 H14 A2,2 0 0 1 16,4 V14 A2,2 0 0 1 14,16 H6 A2,2 0 0 1 4,14 V4 A2,2 0 0 1 6,2 M3,6 H2 A2,2 0 0 0 0,8 V18 A2,2 0 0 0 2,20 H10 A2,2 0 0 0 12,18 V17 H4 A1,1 0 0 1 3,16 Z" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ExportMasterDetailExcelCommand}"
                                    ToolTip="Excel 저장">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M3,2 H13 A2,2 0 0 1 15,4 V7 H13 V4 H3 V16 H8 V18 H3 A2,2 0 0 1 1,16 V4 A2,2 0 0 1 3,2 M10,8 H12 V11 H15 V13 H12 V16 H10 V13 H7 V11 H10 Z" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Master Key" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedMasterKey}" IsReadOnly="True" Width="210" Margin="8,0,0,0" />
                                <TextBlock Text="변경된 Parameter만 저장 요청됩니다."
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="편집" IsEnabled="{Binding CanManageMaster}" ToolTip="관리자 계정에서만 사용할 수 있습니다." Command="{Binding BeginEditCommand}" />
                                <Border Style="{StaticResource RowCountBadgeStyle}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding ChangedMasterCount, StringFormat='변경 {0:N0}건'}" />
                                </Border>
                                <Button Content="변경 미리보기 / 저장" IsEnabled="{Binding CanManageMaster}" ToolTip="변경 전후 값을 비교하고 저장을 확정합니다." Style="{StaticResource SoftPrimaryButtonStyle}" Command="{Binding SaveMasterDetailCommand}" />
                                <Button Content="취소" Command="{Binding CancelEditCommand}" />
                                <Button Content="파일로 저장" Command="{Binding SaveMasterJsonFileCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding MasterParameters}"
                              bh:DataGridHiddenColumnsBehavior.HiddenColumns="ControlType"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="1.5*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Master 설정값" Binding="{Binding DisplayValue}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="수정" Width="1.7*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource MasterEditTemplateSelector}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Type" Binding="{Binding ControlType}" Width="0.75*" IsReadOnly="True" />
                            <DataGridTextColumn Header="변경" Binding="{Binding IsChanged}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
