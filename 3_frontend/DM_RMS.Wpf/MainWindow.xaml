<Window x:Class="DM_RMS.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DM_RMS.Wpf.Views"
        Title="DM_RMS 통합 프로그램" Height="920" Width="1480" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Icon="/DM_RMS;component/Resources/DM_RMS.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="로그인한 사업장 기준으로 Recipe / Master Recipe 데이터가 조회됩니다." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding UserDisplayText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="Fab 변경은 재로그인 후 적용" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="5">
            <TabItem Header="Recipe Matching 현황">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="불일치 Recipe 조회">
                <views:NonMatchingRecipeView DataContext="{Binding NonMatchingRecipe}" />
            </TabItem>
            <TabItem Header="No Master Recipe 조회">
                <views:NoMasterRecipeView DataContext="{Binding NoMasterRecipe}" />
            </TabItem>
            <TabItem Header="집계 제외 Recipe 조회">
                <views:ExcludeRecipeView DataContext="{Binding ExcludeRecipe}" />
            </TabItem>
            <TabItem Header="Recipe 관리">
                <views:RecipeManagementView DataContext="{Binding Recipe}" />
            </TabItem>
            <TabItem Header="Master Recipe 관리">
                <views:MasterManagementView DataContext="{Binding Master}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
