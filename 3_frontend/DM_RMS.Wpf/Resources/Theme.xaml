<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#4F7FD8</Color>
    <Color x:Key="PrimaryDarkColor">#3F6FC4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F3F6FA</Color>
    <Color x:Key="BorderColor">#D7DEE8</Color>
    <Color x:Key="TextColor">#1F2937</Color>
    <Color x:Key="MutedTextColor">#6B7280</Color>
    <Color x:Key="DangerColor">#D86A6A</Color>
    <Color x:Key="WarnRowColor">#FFF1F2</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnRowBrush" Color="{StaticResource WarnRowColor}" />

    <SolidColorBrush x:Key="SoftPrimaryBackgroundBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="SoftPrimaryBorderBrush" Color="#B9CDEF" />
    <SolidColorBrush x:Key="SoftPrimaryForegroundBrush" Color="#315FAD" />
    <SolidColorBrush x:Key="SoftDangerBackgroundBrush" Color="#FFF0F0" />
    <SolidColorBrush x:Key="SoftDangerBorderBrush" Color="#F1B7B7" />
    <SolidColorBrush x:Key="SoftDangerForegroundBrush" Color="#B94D4D" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Malgun Gothic" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style TargetType="ComboBox">
        <!-- 모든 기본/편집 가능 콤보박스의 콘텐츠 및 항목을 수직 중앙 정렬 -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <Style x:Key="PageHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8,8,8,4" />
    </Style>

    <Style x:Key="ActionBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="8,4,8,8" />
    </Style>

    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#EAF1FF" />
        <Setter Property="BorderBrush" Value="#BFD3FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>




    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <Style TargetType="GroupBox" x:Key="CardGroupBoxStyle">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF4" />
        <Setter Property="VerticalGridLinesBrush" Value="#EEF2F7" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF3FA" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SoftPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SoftPrimaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SoftPrimaryBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SoftPrimaryForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SoftDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SoftDangerBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SoftDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SoftDangerForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style x:Key="SoftPrimarySmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SoftDangerSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftDangerButtonStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Background" Value="#F8FAFD" />
        <Setter Property="BorderBrush" Value="#D7DEE8" />
        <Setter Property="Foreground" Value="#53657A" />
    </Style>

    <Style x:Key="RowCountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#F3F6FA" />
        <Setter Property="BorderBrush" Value="#D7DEE8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FilterBarStyle" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFD" />
        <Setter Property="BorderBrush" Value="#E1E7EF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="ProcessingActionPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#FAFBFD" />
        <Setter Property="BorderBrush" Value="#DCE3EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="StatusBarCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFD" />
        <Setter Property="BorderBrush" Value="#DCE3EC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

</ResourceDictionary>
